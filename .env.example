# AgentCo configuration. Copy to .env and fill in; real environment variables win over .env.
# Never paste keys into chat, issues or git: .env is git-ignored and kept out of the Docker image.
# Comments sit on their own lines (Docker's env-file parser does not strip trailing comments).

# ── 1. Anthropic models (the founder's choice) ─────────────────────────────────────────────────
# High-level models for executives and managers, the low-level model for workers:
#   executives → frontier = Claude Opus 5.5   ($4 / $20 per million input / output tokens)
#   managers   → standard = Claude Sonnet 5.5 ($2 / $10)
#   workers    → economy  = Claude Haiku 5.5  ($0.10 / $0.50)
# Without a key every tier runs on the offline deterministic mock (free). After adding the key,
# run `npm run check:models` (or `docker compose exec agentco npm run check:models`) once.
ANTHROPIC_API_KEY=
MODEL_FRONTIER=anthropic:claude-opus-5-5
MODEL_STANDARD=anthropic:claude-sonnet-5-5
MODEL_ECONOMY=anthropic:claude-haiku-5-5
# Put managers on the executives' model too: frontier | standard (unset = standard for new
# managers; setting it also moves existing standard/frontier managers at the next boot).
# MANAGER_MODEL_TIER=frontier

# ── 2. Budgets (hard stops; start small, raise in the console when you trust the spend) ────────
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=50
# Your time zone (IANA name): "today" and "this month" for budgets and the overview start at
# your local midnight. Unset = UTC.
# TZ=Asia/Singapore

# ── 3. Server and access ───────────────────────────────────────────────────────────────────────
# Required whenever the server is reachable from the network (Docker, LAN, VPS): 24+ random
# characters, sent by the console as `Authorization: Bearer <token>`. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# or in PowerShell:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
APP_AUTH_TOKEN=
# Defaults: 127.0.0.1 / 3000 / ./data for `npm start`. Docker Compose pins HOST=0.0.0.0,
# PORT=3000 and DATA_DIR=/data inside the container, whatever is written here.
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=./data
# Extra browser origins allowed to change state (comma separated). The page's own origin
# (e.g. http://192.168.1.92:3000) always is; add the public https origin when a reverse proxy
# rewrites the Host header.
ALLOWED_ORIGINS=
# Extra Host names accepted besides loopback names and HOST (DNS-rebinding guard; only checked
# when HOST is a specific address, not 0.0.0.0), e.g. agentco.lan,192.168.1.92
ALLOWED_HOSTS=

# ── 4. Company ─────────────────────────────────────────────────────────────────────────────────
COMPANY_NAME=AgentCo
# startup (about 19 agents) | enterprise (about 45 agents). Fixed at the first boot.
# ORG_TEMPLATE: startup (~19) | enterprise (~45) | agency (~46, catalog specialists)
ORG_TEMPLATE=startup
# CATALOG_DIR=./catalog
# CATALOG_PLAYBOOK_TOKENS=900
MAX_CONCURRENT_RUNS=4
MAX_HEADCOUNT=60
HIRING_REQUIRES_APPROVAL=true
# >0 lets executives review OKRs on a timer (costs tokens even when nobody asks for anything)
HEARTBEAT_MINUTES=0

# ── 5. Runtime limits ──────────────────────────────────────────────────────────────────────────
RUN_TIMEOUT_MS=300000
REFLEX_MAX_STEPS=8
BRAIN_MAX_REVISIONS=2
CONTEXT_TRIGGER_PCT=0.7
CONTEXT_CARRY_TURNS=6

# ── 6. Optional fallbacks and other providers ──────────────────────────────────────────────────
# A fallback is tried once when the primary errors, and only if its provider has a key here;
# a fallback without a key is ignored and never affects the primary.
MODEL_FRONTIER_FALLBACK=
MODEL_STANDARD_FALLBACK=
MODEL_ECONOMY_FALLBACK=
# Examples:  MODEL_ECONOMY_FALLBACK=openai:gpt-6-luna   MODEL_FRONTIER_FALLBACK=gemini:gemini-4-argon
#            MODEL_ECONOMY=ark:<endpoint-or-model-id>   MODEL_STANDARD=openrouter:<vendor/model>
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Override price table / context windows: {"<profileId>":{"inputPerMTokUsd":0.1,"outputPerMTokUsd":0.4,"contextWindow":128000}}
MODEL_PRICES_JSON=
# Override stage → tier cascade: {"brain.planning":"agent","brain.evaluation":"economy"}
STAGE_ROUTING=

# ── 7. Tools ───────────────────────────────────────────────────────────────────────────────────
WEB_FETCH_ENABLED=false
MOCK_LATENCY_MS=400
