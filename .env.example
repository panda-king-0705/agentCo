# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
# Required when HOST is not loopback (24+ random chars). Sent as `Authorization: Bearer <token>`.
APP_AUTH_TOKEN=
DATA_DIR=./data

# ── Company ────────────────────────────────────────────
COMPANY_NAME=AgentCo
ORG_TEMPLATE=startup            # startup (~18 agents) | enterprise (~45 agents)
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=100
MAX_CONCURRENT_RUNS=4
MAX_HEADCOUNT=60
HIRING_REQUIRES_APPROVAL=true
HEARTBEAT_MINUTES=0             # >0 lets executives review OKRs on a timer (costs tokens)

# ── Runtime limits ─────────────────────────────────────
RUN_TIMEOUT_MS=300000
REFLEX_MAX_STEPS=8
BRAIN_MAX_REVISIONS=2
CONTEXT_TRIGGER_PCT=0.7
CONTEXT_CARRY_TURNS=6

# ── Models: <provider>:<model>. Unset keys fall back to the offline mock. ──
MODEL_FRONTIER=mock:frontier
MODEL_STANDARD=mock:standard
MODEL_ECONOMY=mock:economy
MODEL_FRONTIER_FALLBACK=
MODEL_STANDARD_FALLBACK=
MODEL_ECONOMY_FALLBACK=
# Example (BytePlus ModelArk):  MODEL_ECONOMY=ark:<endpoint-or-model-id>
# Example (OpenAI):             MODEL_ECONOMY=openai:<mini-model>
# Example (OpenRouter):         MODEL_STANDARD=openrouter:<vendor/model>

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Override price table / context windows: {"<profileId>":{"inputPerMTokUsd":0.1,"outputPerMTokUsd":0.4,"contextWindow":128000}}
MODEL_PRICES_JSON=
# Override stage → tier cascade: {"brain.planning":"agent","brain.evaluation":"economy"}
STAGE_ROUTING=

# ── Tools ──────────────────────────────────────────────
WEB_FETCH_ENABLED=false
MOCK_LATENCY_MS=400
