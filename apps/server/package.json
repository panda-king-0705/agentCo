{
  "name": "@agentco/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency control plane. Runs directly on Node >= 22.18 (type stripping + node:sqlite).",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
